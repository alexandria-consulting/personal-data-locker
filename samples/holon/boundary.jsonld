{
  "@context": {
    "@version": 1.1,
    "holon": "http://w3id.org/holon/",
    "hev": "http://w3id.org/holon/event/",
    "hproj": "http://w3id.org/holon/projection/",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "sh": "http://www.w3.org/ns/shacl#",
    "prov": "http://www.w3.org/ns/prov#",
    "dcterms": "http://purl.org/dc/terms/",
    "schema": "https://schema.org/",
    "fl": "__H__vocab.jsonld#"
  },
  "@graph": [
    {
      "@id": "__H__boundary.jsonld#EventShape",
      "@type": "sh:NodeShape",
      "rdfs:label": "Event boundary",
      "rdfs:comment": "Every event entering Billy's holons names its holon, fluent and value, carries both bitemporal timestamps, and says what produced it.",
      "sh:targetClass": [
        {
          "@id": "hev:AssertionEvent"
        },
        {
          "@id": "hev:ObservationEvent"
        }
      ],
      "sh:property": [
        {
          "sh:path": {
            "@id": "hev:targetHolon"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:nodeKind": {
            "@id": "sh:IRI"
          }
        },
        {
          "sh:path": {
            "@id": "fl:fluent"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:class": {
            "@id": "fl:Fluent"
          }
        },
        {
          "sh:path": {
            "@id": "fl:value"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": {
            "@id": "hev:assertedAt"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:datatype": {
            "@id": "xsd:dateTime"
          }
        },
        {
          "sh:path": {
            "@id": "hev:receivedAt"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:datatype": {
            "@id": "xsd:dateTime"
          },
          "sh:message": "hev:assertedAt and hev:receivedAt must be stored as distinct values."
        },
        {
          "sh:path": {
            "@id": "prov:wasGeneratedBy"
          },
          "sh:minCount": 1,
          "sh:class": {
            "@id": "prov:Activity"
          }
        },
        {
          "sh:path": {
            "@id": "fl:supersedes"
          },
          "sh:maxCount": 1,
          "sh:nodeKind": {
            "@id": "sh:IRI"
          }
        }
      ],
      "sh:sparql": {
        "@type": "sh:SPARQLConstraint",
        "sh:message": "An assertion cannot be received before it was asserted.",
        "sh:select": "PREFIX hev: <http://w3id.org/holon/event/>\nSELECT $this WHERE { $this a hev:AssertionEvent ; hev:assertedAt ?a ; hev:receivedAt ?r . FILTER (?a > ?r) }"
      }
    },
    {
      "@id": "__H__boundary.jsonld#FluentShape",
      "@type": "sh:NodeShape",
      "rdfs:label": "Fluent declaration",
      "sh:targetClass": {
        "@id": "fl:Fluent"
      },
      "sh:property": [
        {
          "sh:path": {
            "@id": "fl:subject"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": {
            "@id": "fl:property"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1
        }
      ]
    },
    {
      "@id": "__H__boundary.jsonld#HeartRateShape",
      "@type": "sh:NodeShape",
      "rdfs:label": "Resting heart rate reading",
      "sh:property": {
        "sh:path": {
          "@id": "fl:value"
        },
        "sh:datatype": {
          "@id": "xsd:integer"
        },
        "sh:minInclusive": 25,
        "sh:maxInclusive": 220
      },
      "sh:targetClass": {
        "@id": "hev:ObservationEvent"
      },
      "rdfs:comment": "Applies to the activity holon, whose only observations are resting heart rate readings."
    }
  ]
}
