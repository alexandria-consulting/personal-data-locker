{
  "@context": {
    "@version": 1.1,
    "holon": "http://w3id.org/holon/",
    "hev": "http://w3id.org/holon/event/",
    "hproj": "http://w3id.org/holon/projection/",
    "ucm": "https://w3.org/ns/ucm#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "sh": "http://www.w3.org/ns/shacl#",
    "prov": "http://www.w3.org/ns/prov#",
    "dcterms": "http://purl.org/dc/terms/",
    "fl": "__H__fluent-vocab.jsonld#"
  },
  "@id": "__H__boundary.jsonld",
  "@graph": [
    {
      "@id": "__H__boundary.jsonld#holon",
      "@type": "holon:AgentHolon",
      "rdfs:label": "Billy's personal data locker",
      "dcterms:description": "Billy's own copy of their care across clinical and social care contexts. Payload terms are from the W3C UCM CG.",
      "holon:registrationStatus": {
        "@id": "holon:CandidateStatus"
      },
      "holon:payloadGraph": {
        "@value": "__H__scene.jsonld",
        "@type": "xsd:anyURI"
      },
      "holon:boundary": [
        {
          "@id": "__H__boundary.jsonld#EventShape"
        },
        {
          "@id": "__H__boundary.jsonld#FluentShape"
        },
        {
          "@id": "ucm:ParticipationShape"
        },
        {
          "@id": "ucm:StatementShape"
        }
      ],
      "holon:boundaryMode": {
        "@id": "holon:OpenBoundary"
      },
      "dcterms:hasPart": [
        {
          "@id": "__H__scene.jsonld"
        },
        {
          "@id": "__H__boundary.jsonld"
        },
        {
          "@id": "__H__event.jsonld"
        },
        {
          "@id": "__H__projection.jsonld"
        }
      ],
      "fl:hasFluent": [
        {
          "@id": "__H__boundary.jsonld#home"
        }
      ],
      "dcterms:subject": {
        "@id": "__POD__profile/card.jsonld#me"
      },
      "holon:contains": [
        {
          "@id": "__H__home-monitoring/boundary.jsonld#holon"
        },
        {
          "@id": "__H__food-security/boundary.jsonld#holon"
        }
      ]
    },
    {
      "@id": "__H__boundary.jsonld#home",
      "@type": "fl:Fluent",
      "rdfs:label": "Where Billy lives",
      "fl:subject": {
        "@id": "__POD__profile/card.jsonld#me"
      },
      "fl:property": {
        "@id": "ucm:locatedAt"
      }
    },
    {
      "@id": "__POD__profile/card.jsonld#me",
      "@type": "ucm:Person",
      "rdfs:label": "Billy Testman"
    },
    {
      "@id": "__H__boundary.jsonld#samuel",
      "@type": "ucm:Person",
      "rdfs:label": "Samuel Whitfield",
      "rdfs:comment": "Community health worker with Eastside Neighbors (persona from the UCM care-team user stories)."
    },
    {
      "@id": "__H__boundary.jsonld#alder-street",
      "@type": "ucm:Location",
      "rdfs:label": "Billy's former apartment, Alder Street"
    },
    {
      "@id": "__H__boundary.jsonld#birch-court",
      "@type": "ucm:Location",
      "rdfs:label": "Billy's apartment, Birch Court"
    },
    {
      "@id": "__H__boundary.jsonld#social-context",
      "@type": "ucm:SocialCareContext",
      "rdfs:label": "Billy's social care"
    },
    {
      "@id": "__H__boundary.jsonld#locker-agent",
      "@type": [
        "prov:Agent",
        "prov:SoftwareAgent"
      ],
      "rdfs:label": "Billy's locker",
      "prov:actedOnBehalfOf": {
        "@id": "__POD__profile/card.jsonld#me"
      }
    },
    {
      "@id": "__H__boundary.jsonld#EventShape",
      "@type": "sh:NodeShape",
      "rdfs:label": "Event boundary",
      "rdfs:comment": "Every event entering Billy's holons names its holon and payload, carries both bitemporal timestamps, and says what produced it. Child holons reuse this shape by reference. UCM content is validated by UCM's core shapes, published at https://github.com/w3c-cg/ucm/blob/main/ucm-core-shapes.ttl.",
      "sh:targetClass": [
        {
          "@id": "hev:AssertionEvent"
        },
        {
          "@id": "hev:ObservationEvent"
        },
        {
          "@id": "hev:CommandEvent"
        }
      ],
      "sh:property": [
        {
          "sh:path": {
            "@id": "hev:targetHolon"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:nodeKind": {
            "@id": "sh:IRI"
          }
        },
        {
          "sh:path": {
            "@id": "hev:assertedAt"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:datatype": {
            "@id": "xsd:dateTime"
          }
        },
        {
          "sh:path": {
            "@id": "hev:receivedAt"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:datatype": {
            "@id": "xsd:dateTime"
          }
        },
        {
          "sh:path": {
            "@id": "prov:wasGeneratedBy"
          },
          "sh:minCount": 1,
          "sh:class": {
            "@id": "prov:Activity"
          }
        },
        {
          "sh:path": {
            "@id": "prov:wasAttributedTo"
          },
          "sh:minCount": 1,
          "sh:nodeKind": {
            "@id": "sh:IRI"
          }
        },
        {
          "sh:path": {
            "@id": "fl:fluent"
          },
          "sh:maxCount": 1,
          "sh:class": {
            "@id": "fl:Fluent"
          }
        },
        {
          "sh:path": {
            "@id": "fl:supersedes"
          },
          "sh:maxCount": 1,
          "sh:nodeKind": {
            "@id": "sh:IRI"
          }
        }
      ],
      "sh:or": {
        "@list": [
          {
            "sh:path": {
              "@id": "hev:assertionPayload"
            },
            "sh:minCount": 1
          },
          {
            "sh:path": {
              "@id": "hev:observationPayload"
            },
            "sh:minCount": 1
          },
          {
            "sh:path": {
              "@id": "hev:commandPayload"
            },
            "sh:minCount": 1
          }
        ]
      },
      "sh:sparql": [
        {
          "@type": "sh:SPARQLConstraint",
          "sh:message": "An assertion cannot be received before it was asserted.",
          "sh:select": "PREFIX hev: <http://w3id.org/holon/event/>\nSELECT $this WHERE { $this a hev:AssertionEvent ; hev:assertedAt ?a ; hev:receivedAt ?r . FILTER (?a > ?r) }"
        },
        {
          "@type": "sh:SPARQLConstraint",
          "sh:message": "An event that records a fluent value must say what the value is.",
          "sh:select": "PREFIX fl: <__H__fluent-vocab.jsonld#>\nSELECT $this WHERE { $this fl:fluent ?f . FILTER NOT EXISTS { $this fl:value ?v } }"
        },
        {
          "@type": "sh:SPARQLConstraint",
          "sh:message": "An event can only supersede an earlier event on the same fluent.",
          "sh:select": "PREFIX fl: <__H__fluent-vocab.jsonld#>\nSELECT $this WHERE { $this fl:supersedes ?old ; fl:fluent ?f . FILTER NOT EXISTS { ?old fl:fluent ?f } }"
        }
      ]
    },
    {
      "@id": "__H__boundary.jsonld#FluentShape",
      "@type": "sh:NodeShape",
      "rdfs:label": "Fluent declaration",
      "sh:targetClass": {
        "@id": "fl:Fluent"
      },
      "sh:property": [
        {
          "sh:path": {
            "@id": "fl:subject"
          },
          "sh:minCount": 1,
          "sh:maxCount": 1
        },
        {
          "sh:path": {
            "@id": "fl:property"
          },
          "sh:maxCount": 1
        }
      ]
    }
  ]
}
