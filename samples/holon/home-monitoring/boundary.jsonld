        },
        {
          "@id": "__H__boundary.jsonld#FluentShape"
        },
        {
          "@id": "ucm:ParticipationShape"
        },
        {
          "@id": "ucm:StatementShape"
        }
      ],
      "holon:boundaryMode": {
